{
  "name": "echo-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Windows + Chrome extension companion for Messenger: read the selected conversation, dictate Vietnamese, edit and hand off drafts manually.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "vite build --config vite.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "bench": "vitest run tests/benchmarks --reporter=verbose",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "@types/chrome": "^0.1.28",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.65.0",
    "esbuild": "npm:esbuild-wasm@0.28.2"
  }
}
